+
+// Turns only this tab into a signed-out guest, leaving every other tab and
+// the shared login alone. Used when a table QR code is opened in a browser
+// where staff are signed in: the person ordering is a customer, not the
+// manager whose login a new tab would otherwise adopt.
+export const detachTabAsGuest = () => {
+  if (!isBrowser()) return;
+  clearFrom(window.sessionStorage);
+  safeSet(window.sessionStorage, SIGNED_OUT_KEY, '1');
+};
diff --git a/easyserve-front-end/src/utilities/dineInStorage.js b/easyserve-front-end/src/utilities/dineInStorage.js
new file mode 100644
index 0000000..6dfa8c0
--- /dev/null
+++ b/easyserve-front-end/src/utilities/dineInStorage.js
@@ -0,0 +1,26 @@
+// The dine-in table session lives in Redux while the guest browses and in
+// localStorage so a refresh (or opening "My Orders") keeps it. Its token is
+// what lets a guest order and pay without an account.
+
+export const DINE_IN_STORAGE_KEY = "easyserve:dine-in-context";
+
+export const readSavedDineIn = () => {
+  if (typeof window === "undefined") return null;
+  try {
+    const raw = window.localStorage.getItem(DINE_IN_STORAGE_KEY);
+    return raw ? JSON.parse(raw) : null;
+  } catch (_) {
+    return null;
+  }
+};
+
+export const getDineInToken = (state) =>
+  state?.dineIn?.sessionToken || readSavedDineIn()?.sessionToken || null;
+
+export const clearSavedDineIn = () => {
+  try {
+    window.localStorage.removeItem(DINE_IN_STORAGE_KEY);
+  } catch (_) {
+    // Storage can be unavailable (private mode); nothing to clear then.
+  }
+};
